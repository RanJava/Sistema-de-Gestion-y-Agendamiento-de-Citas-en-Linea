@startuml HU01_secuencia
actor Cliente
participant "Interfaz de Registro" as UI
participant "Controlador de Cuenta" as CTRL
database "Base de Datos" as DB

Cliente -> UI : Completa nombre, telefono, correo
UI -> CTRL : enviarRegistro(nombre, telefono, correo)

alt Campos vacios o formato invalido
    CTRL -> UI : error de validacion (campo/formato)
    UI --> Cliente : Muestra mensaje de error
else Datos validos
    CTRL -> DB : buscarClientePorCorreo(correo)
    DB --> CTRL : resultado

    alt Correo ya registrado
        CTRL -> UI : error "correo ya en uso"
        UI --> Cliente : Muestra mensaje de error
    else Correo disponible
        CTRL -> DB : guardarCliente(nombre, telefono, correo)
        DB --> CTRL : confirmacion de guardado
        CTRL -> UI : registro exitoso
        UI --> Cliente : Redirige a login/home
    end
end
@enduml
