@startuml HU04_secuencia
actor Cliente
participant "Interfaz de Reserva" as UI
participant "Controlador de Cita" as CTRL
database "Base de Datos" as DB

Cliente -> UI : Selecciona servicio, barbero y horario
UI -> CTRL : validarSeleccion(servicio, barbero, horario)
CTRL -> UI : habilita boton confirmar reserva
Cliente -> UI : Confirma reserva

alt Usuario ingreso como invitado
    UI -> Cliente : Exige iniciar sesion o registrarse
else Usuario autenticado
    UI -> CTRL : confirmarReserva(idCliente, servicio, barbero, horario)
    CTRL -> DB : verificarYReservarTurno(horario)

    alt Turno ya tomado por otra solicitud
        DB --> CTRL : turno no disponible
        CTRL -> UI : alerta turno tomado
        UI --> Cliente : Muestra alerta y solicita elegir otro turno
    else Turno disponible
        DB --> CTRL : turno reservado
        CTRL -> CTRL : calcularDuracionPrecio(idServicio)
        CTRL -> DB : guardarCita(idCliente, servicio, barbero, horario, estado="pendiente")
        DB --> CTRL : confirmacion
        CTRL -> UI : cita registrada
        UI --> Cliente : Reserva confirmada, estado pendiente
    end
end
@enduml
