@startuml HU06_estados
[*] --> Pendiente : Cita reservada (HU-04)

state Pendiente {
  Pendiente --> Cancelada : Cliente cancela cita (HU-06)
  Pendiente --> Atendida : Administrador marca atendida (HU-08)
}

state Atendida {
  Atendida --> [*] : Cita completada
  Atendida -[hidden]-> Cancelada
  note right of Atendida : Intentar cancelar desde "Atendida"\nproduce rechazo con HTTP 409 Conflict
}

state Cancelada {
  Cancelada --> [*] : Turno liberado a "Disponible"
}
@enduml
